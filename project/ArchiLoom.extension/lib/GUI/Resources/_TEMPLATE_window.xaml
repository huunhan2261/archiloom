<!-- ArchiLoom GUI template — UI Standard v2.
     Copy into a *.pushbutton/ folder together with _TEMPLATE_script.py and
     rename both. Do NOT define colours or font sizes here; every value comes
     from the shared dictionary merged by GUI.theme.apply_theme(self).
     Rules: lib/GUI/Resources/UI_GUIDELINE.md -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ArchiLoom Tool"
    Height="Auto" Width="460"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="{StaticResource bg_window}">

    <StackPanel>

        <!-- ============ HEADER ============
             Green band 52 + title 20/SemiBold + window buttons, then the
             single coral 2px rule, edge to edge.
             Written INLINE on purpose: Click="..." and x:Name inside a
             Style/ControlTemplate/DataTemplate are never wired to
             code-behind by wpf.LoadComponent. Copy this whole block as-is
             into every new window. -->
        <Grid Background="{StaticResource green_500}" Height="52"
              MouseDown="header_drag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="main_title" Text="__title__"
                       Grid.Column="0" Margin="16,0,0,0"
                       Style="{StaticResource TitleText}"/>
            <Button Content="&#x2715;" Grid.Column="1"
                    Margin="0,0,8,0"
                    Style="{StaticResource HeaderIconButton}"
                    Click="button_close"
                    VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Border Style="{StaticResource AccentRule}"/>

        <!-- ============ BODY ============
             Gutter 16 on all sides. Vertical rhythm: 4 / 8 / 12 / 16 only. -->
        <StackPanel Margin="16,16,16,0">

            <TextBlock Style="{StaticResource HelpText}"
                       Text="One or two lines on what this tool does. Same wording as bundle.yaml tooltip."
                       Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Report author" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center"/>
                <TextBox x:Name="input_author" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

                <Label Content="Raw data folder" Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center"/>
                <DockPanel Grid.Row="1" Grid.Column="1">
                    <!-- Ghost green = safe secondary action inside a row -->
                    <Button Content="Browse..." DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}"
                            Click="button_browse"/>
                    <TextBox x:Name="input_folder"/>
                </DockPanel>
            </Grid>

            <!-- ONE message bar, hidden until there is something to say.
                 Fill from code: set_message(self.msg_bar, self.msg_text, 'warn', "...") -->
            <Border x:Name="msg_bar" Style="{StaticResource MessageInfo}"
                    Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="msg_text" Style="{StaticResource MessageInfoText}"/>
            </Border>

        </StackPanel>

        <!-- ============ FOOTER ============
             Neutral hairline, then: brand wordmark bottom-left, status text,
             secondary outline, and exactly ONE coral primary on the right.
             The logo Source is set from code (set_logo(self.footer_logo)) —
             lib/GUI/Resources/ has no pack URI from a pushbutton folder. -->
        <Border Style="{StaticResource Rule}" Margin="0,16,0,0"/>
        <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="footer_logo" Grid.Column="0" Height="16"
                   Margin="0,0,16,0" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock x:Name="text_status" Grid.Column="1"
                       Style="{StaticResource HelpText}"
                       VerticalAlignment="Center"/>
            <Button Content="Cancel" Grid.Column="2" Click="button_close"/>
            <Button Content="Run" Grid.Column="3" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="button_run"/>
        </Grid>

    </StackPanel>
</Window>
